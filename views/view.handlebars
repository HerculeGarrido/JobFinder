<div id="job-view-container" class="container"> <!-- Corrigido o hífen no id -->
    <div class="row text-center">
        <a class="back-link main-color" href="/">Voltar</a>
        <div id="img-container" class="col-md-12">
             <img src="/img/company.jpg" alt="Company">
        </div>
    </div>
    <div class="col-md-12">
        <h1 class="main-color">{{job.title}}</h1> <!-- Sem dataValues -->
        <p class="bold">Quem eles estão buscando:</p>
        <p class="job-desc">{{job.description}}</p> <!-- Conteúdo fora da tag <p> -->
        <p><span class="bold">O salário informado é de: </span>R${{job.salary}}</p>
        <p>
            Para trabalhar na <span class="bold main-color">{{job.company}}</span> 
            envie um email para <a href="mailto:{{job.email}}">{{job.email}}</a> <!-- Corrigido mailto: -->
        </p>
    </div>
</div>
